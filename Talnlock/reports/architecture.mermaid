graph TD
    %% Styling
    classDef ingestion fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#fff;
    classDef lakehouse fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#fff;
    classDef ml fill:#701a75,stroke:#d946ef,stroke-width:2px,color:#fff;
    classDef service fill:#0f172a,stroke:#475569,stroke-width:2px,color:#fff;
    classDef user fill:#7c2d12,stroke:#f97316,stroke-width:2px,color:#fff;

    %% Data Ingestion Layer
    subgraph Ingestion ["1. Data Ingestion Layer"]
        API[Social Media APIs <br> Instagram / LinkedIn / YouTube]:::ingestion
        Kafka[Apache Kafka Message Broker]:::ingestion
        Airflow[Apache Airflow Scheduler]:::ingestion
        API --> Kafka
        Kafka --> Airflow
    end

    %% Data Lakehouse Layer
    subgraph Storage ["2. Data Lakehouse & Prep"]
        S3[S3 Delta Lake / Object Storage]:::lakehouse
        DBT[dbt Data Build Tool]:::lakehouse
        Airflow --> S3
        S3 --> DBT
    end

    %% Machine Learning Layer
    subgraph ML ["3. ML Pipeline & Explainer"]
        MLflow[MLflow Training Suite]:::ml
        Registry[MLflow Model Registry]:::ml
        DBT --> MLflow
        MLflow --> Registry
    end

    %% Service Layer (FastAPI backend)
    subgraph Serving ["4. API Serving & AI Layer"]
        FastAPI[FastAPI Backend Server]:::service
        Redis[Redis In-Memory Cache]:::service
        Ollama[Ollama / Cloud LLM APIs]:::service
        Registry --> FastAPI
        FastAPI <--> Redis
        FastAPI <--> Ollama
    end

    %% User & Monitoring Layer
    subgraph Presentation ["5. Presentation & Monitoring"]
        Dashboard[HTML/CSS/JS Dashboard UI]:::user
        Evidently[Evidently AI Model Monitor]:::user
        FastAPI <--> Dashboard
        FastAPI --> Evidently
    end

    class Ingestion,Storage,ML,Serving,Presentation service;
